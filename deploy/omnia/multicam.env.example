MULTICAM_BACKEND_NAME=Omnia
MULTICAM_PUBLIC_URL=https://192.168.1.20:8000
MULTICAM_REQUIRED_STORAGE_MOUNT=/srv/multicam-ssd
MULTICAM_STORAGE_ID=REPLACE_WITH_SSD_ID
MULTICAM_DATA_DIR=/srv/multicam-ssd/data/sessions
MULTICAM_FEDERATION_CONFIG=/srv/multicam-ssd/data/federation.json
MULTICAM_BACKEND_ID_FILE=/srv/multicam-ssd/data/backend-id
MULTICAM_CERT=/srv/multicam-ssd/certs/server.cert.pem
MULTICAM_KEY=/srv/multicam-ssd/certs/server.key.pem
# Router stores originals; expensive conversion stays on capture notebooks.
MULTICAM_TRANSCODE=0
MULTICAM_DISCOVERY=1
MULTICAM_FEDERATION_TRANSFER=1
PYTHONDONTWRITEBYTECODE=1
TMPDIR=/srv/multicam-ssd/tmp
