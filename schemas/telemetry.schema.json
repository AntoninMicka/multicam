{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multicam.local/schemas/telemetry-1.0.json",
  "title": "MultiCam telemetry event",
  "description": "Schéma jednoho řádku timing.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event", "monotonic_ms", "camera", "position", "orientation"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event": {
      "enum": ["recording_requested", "recording_started", "recording_stopped", "clock_sample", "sync_marker"]
    },
    "monotonic_ms": { "type": "number", "minimum": 0 },
    "recording_offset_ms": { "type": ["number", "null"] },
    "utc_time": { "type": ["string", "null"], "format": "date-time" },
    "server_offset_ms": { "type": ["number", "null"] },
    "round_trip_ms": { "type": ["number", "null"], "minimum": 0 },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zoom_ratio", "field_of_view_deg", "width", "height"],
      "properties": {
        "zoom_ratio": { "type": ["number", "null"], "minimum": 0 },
        "field_of_view_deg": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 360 },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "position": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["latitude", "longitude", "accuracy_m", "altitude_m", "altitude_accuracy_m", "heading_deg", "speed_m_s", "timestamp_ms"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "accuracy_m": { "type": "number", "minimum": 0 },
        "altitude_m": { "type": ["number", "null"] },
        "altitude_accuracy_m": { "type": ["number", "null"], "minimum": 0 },
        "heading_deg": { "type": ["number", "null"], "minimum": 0, "maximum": 360 },
        "speed_m_s": { "type": ["number", "null"], "minimum": 0 },
        "timestamp_ms": { "type": "number" }
      }
    },
    "orientation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["alpha_deg", "beta_deg", "gamma_deg", "absolute"],
      "properties": {
        "alpha_deg": { "type": ["number", "null"] },
        "beta_deg": { "type": ["number", "null"] },
        "gamma_deg": { "type": ["number", "null"] },
        "absolute": { "type": "boolean" }
      }
    },
    "details": { "type": "object" }
  }
}
